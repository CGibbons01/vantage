{
  "expo": {
    "name": "Vantage ai recruitment",
    "slug": "vantage-ai-recruitment",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-lca.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-icon-lca.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.placeholder.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.placeholder.app.onesignal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-lca.png",
        "backgroundColor": "#000000"
      },
      "package": "com.gibbonsrecruitment.VantageAI"
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "scheme": "vantageairecruitment",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
